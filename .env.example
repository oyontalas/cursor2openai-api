# 复制为 .env 并按需修改
# cp .env.example .env

# 外部调用本服务时必须携带的 API Key (留空 = 不校验, 不推荐)
API_KEY=

# 监听端口 / 地址
# PORT=3000
# HOST=0.0.0.0

# Cursor Token 文件路径
# TOKEN_FILE=./token.json

# 默认模型
# DEFAULT_MODEL=claude-4.5-sonnet

# Cursor 客户端版本号 (需跟上游保持较新, 太旧会被拒 "Update Required")
# CURSOR_CLIENT_VERSION=3.12.17

# 请求超时 (ms)
# REQUEST_TIMEOUT=120000

# ══════════════════════════════════════════════════════════════
#  以下均为 Agent 工具支持相关配置, 只有 VSCode Copilot Chat 这类
#  会在请求里声明 tools/自带 Agent 模式的客户端才用得到。
#  纯文本对话 (不带 tools 的普通 OpenAI 请求) 完全不受影响。
# ══════════════════════════════════════════════════════════════

# tool_calls 桥接 (推荐): 客户端声明了 tools 时, 把 Agent 内部的"写文件"
# 请求转换成标准 OpenAI tool_calls (create_file), 交还客户端在真实工作区里执行。
# BRIDGE_TOOLS=1

# shell 的 tool_calls 桥接 (run_in_terminal): 让客户端 (如 VSCode Copilot) 弹出
# 原生的"允许执行此命令?"确认框, 用户确认后由客户端自己的终端真实执行。
# 需要同时开启 BRIDGE_TOOLS=1。
# BRIDGE_SHELL=1

# Agent 工具: 限定 read/ls/grep/write 的工作目录 (默认进程 cwd)
# WORKSPACE_ROOT=/path/to/workspace

# Agent 工具: 是否允许直接在服务器上真实写入/删除 WORKSPACE_ROOT 内的文件 (默认关闭)
# 开启 BRIDGE_TOOLS 后一般不需要再配置这个。
# ENABLE_WRITE=1

# Agent 工具: 是否允许模型在本服务器所在机器上真实执行 shell 命令, 且不弹确认框 (默认关闭)。
# ⚠️ 相当于给模型完整的本机 shell 权限, 只应在你信任的本地/内网环境开启。
# 若同时开启了 BRIDGE_TOOLS=1 + BRIDGE_SHELL=1, 会优先走桥接 (有确认框); 只有在没有
# 桥接可用时 (比如直接用 curl/SDK 调 API, 没声明 tools) 才会用这里的服务器直接执行。
# ENABLE_SHELL=1

# ENABLE_SHELL=1 时: 单条命令的最长执行时间 (ms), 超时会被 SIGKILL
# SHELL_TIMEOUT_MS=120000

# ENABLE_SHELL=1 时: 单条命令 stdout+stderr 的最大字节数, 超出会被截断并终止进程
# SHELL_MAX_OUTPUT_BYTES=200000

# shell 执行完毕后, 若 Cursor 会话在这么久 (ms) 内仍未继续推进对话, 就直接用本地
# 已捕获的真实执行结果收尾返回, 而不是一直等到失败超时 (对 ENABLE_SHELL 和 BRIDGE_SHELL 都生效)
# SHELL_FALLBACK_GRACE_MS=15000
