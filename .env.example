# 复制为 .env 并按需修改
# cp .env.example .env

# 外部调用本服务时必须携带的 API Key (留空 = 不校验, 不推荐)
API_KEY=

# 监听端口 / 地址
# PORT=3000
# HOST=0.0.0.0

# Cursor Token 文件路径
# TOKEN_FILE=./token.json

# 默认模型
# DEFAULT_MODEL=claude-4.5-sonnet

# Cursor 客户端版本号 (需跟上游保持较新, 太旧会被拒 "Update Required")
# CURSOR_CLIENT_VERSION=3.12.17

# 请求超时 (ms)
# REQUEST_TIMEOUT=120000

# 连接 Cursor 后端时, 如果在还没收到任何真实响应前就失败 (比如 TLS 握手中途被打断、网络抖动),
# 判定为纯网络问题, 自动重试这么多次 (不计入首次尝试) 再放弃
# CONNECT_RETRY_COUNT=2
# 每次重试之间的等待时间 (ms)
# CONNECT_RETRY_DELAY_MS=600

# ══════════════════════════════════════════════════════════════
#  以下均为 Agent 工具支持相关配置, 只有 VSCode Copilot Chat 这类
#  会在请求里声明 tools/自带 Agent 模式的客户端才用得到。
#  纯文本对话 (不带 tools 的普通 OpenAI 请求) 完全不受影响。
# ══════════════════════════════════════════════════════════════

# tool_calls 桥接 (推荐): 客户端声明了 tools 时, 把 Agent 内部的"写文件"
# 请求转换成标准 OpenAI tool_calls (create_file), 交还客户端在真实工作区里执行。
# BRIDGE_TOOLS=1

# shell 的 tool_calls 桥接 (run_in_terminal): 让客户端 (如 VSCode Copilot) 弹出
# 原生的"允许执行此命令?"确认框, 用户确认后由客户端自己的终端真实执行。
# 需要同时开启 BRIDGE_TOOLS=1。
# BRIDGE_SHELL=1

# Agent 工具: 限定 read/ls/grep/write 的工作目录 (默认进程 cwd)
# WORKSPACE_ROOT=/path/to/workspace

# Agent 工具: 服务端直接处理 read 时, 单文件最多读取的字节数 (默认 120000)
# CURSOR_TOOL_MAX_READ_BYTES=120000

# Agent 工具: 服务端直接处理 ls/grep/glob 时, 最多返回的条目数 (默认 200)
# CURSOR_TOOL_MAX_LIST_ENTRIES=200

# Agent 工具: 是否允许直接在服务器上真实写入/删除 WORKSPACE_ROOT 内的文件 (默认关闭)
# 开启 BRIDGE_TOOLS 后一般不需要再配置这个。
# ENABLE_WRITE=1

# Agent 工具: 是否允许模型在本服务器所在机器上真实执行 shell 命令, 且不弹确认框 (默认关闭)。
# ⚠️ 相当于给模型完整的本机 shell 权限, 只应在你信任的本地/内网环境开启。
# 若同时开启了 BRIDGE_TOOLS=1 + BRIDGE_SHELL=1, 会优先走桥接 (有确认框); 只有在没有
# 桥接可用时 (比如直接用 curl/SDK 调 API, 没声明 tools) 才会用这里的服务器直接执行。
# ENABLE_SHELL=1

# ENABLE_SHELL=1 时: 单条命令的最长执行时间 (ms), 超时会被 SIGKILL
# SHELL_TIMEOUT_MS=120000

# ENABLE_SHELL=1 时: 单条命令 stdout+stderr 的最大字节数, 超出会被截断并终止进程
# SHELL_MAX_OUTPUT_BYTES=200000

# shell 执行完毕后, 若 Cursor 会话在这么久 (ms) 内仍未继续推进对话, 就直接用本地
# 已捕获的真实执行结果收尾返回, 而不是一直等到失败超时 (对 ENABLE_SHELL 和 BRIDGE_SHELL 都生效)
# SHELL_FALLBACK_GRACE_MS=15000

# tool_calls 桥接后, 等待真人在 IDE 里确认执行 (比如 shell 的"允许执行此命令?"确认框) 的
# 最长时间 (ms)。到点了不会报错中断对话, 只是回收这个会话占用的内存, 真人晚一点确认时会
# 自动改用"开新会话续接完整历史"兜底。可以设得很宽松。
# BRIDGE_SESSION_TIMEOUT=1800000

# ── 长任务/多轮工具调用相关调优 ──
# shell/shellStream 工具调用在原 Cursor 会话里续接不上时, 会放弃旧会话、带着完整对话历史
# (含之前所有工具调用与结果) 开一个新会话继续。任务步骤越多, 这个 prompt 就越长, 处理耗时
# 也越长, 下面两组参数分别控制"允许等多久"和"历史最多留多少"。

# 首字超时基础值 (ms): 等待 Cursor 后端给出第一个响应字符的最长时间, 超过判定失败
# STREAM_FIRST_CHUNK_TIMEOUT=90000
# 首字超时会随 prompt 长度自适应变长 (STREAM_FIRST_CHUNK_TIMEOUT + prompt字符数 * 下面这个系数),
# 但不会超过这个绝对上限 (ms)
# STREAM_FIRST_CHUNK_TIMEOUT_MAX=300000
# 每 1 个 prompt 字符额外增加的等待时间 (ms/字符)
# STREAM_FIRST_CHUNK_MS_PER_CHAR=2

# 流式响应中, 两次数据帧之间的最长静默时间 (ms), 超过判定失败
# STREAM_IDLE_TIMEOUT=60000

# 本服务是纯中转/桥接, 不会对重建出来的历史 prompt 做长度裁剪或死循环检测——上下文长度、
# 重复调用等应由调用方 (agent/客户端) 自行控制; 如果内容确实超出模型上限, 会由 Cursor 后端
# 自然报错, 再原样透传给调用方。
